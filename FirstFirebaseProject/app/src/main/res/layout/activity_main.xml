<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FBF8F8"
    android:backgroundTint="#F6EFEF"
    tools:context=".MainActivity">

    <androidx.appcompat.widget.Toolbar
        android:layout_width="match_parent"
        android:id="@+id/toolbar"
        android:layout_height="50dp"
        android:background="#5186BC"
        app:menu="@menu/menu_delete_all"
        tools:ignore="MissingConstraints">

    </androidx.appcompat.widget.Toolbar>


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycleview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="50dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0"
        tools:listitem="@layout/user_items" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/floatingActionButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="325dp"
        android:layout_marginTop="607dp"
        android:layout_marginEnd="31dp"
        android:layout_marginBottom="38dp"
        android:background="@drawable/circle_shape"
        android:clickable="true"
        android:contentDescription="@string/todos"
        android:focusable="true"
        app:backgroundTint="#5F73BA"
        app:layout_constraintBottom_toBottomOf="@+id/recycleview"
        app:layout_constraintEnd_toEndOf="@+id/recycleview"
        app:layout_constraintStart_toStartOf="@+id/recycleview"
        app:layout_constraintTop_toTopOf="@+id/recycleview"
        app:srcCompat="@drawable/baseline_add_24" />

</androidx.constraintlayout.widget.ConstraintLayout>